### Рівень 1: REST CRUD
@base = https://dummyjson.com

###
# GET — отримати товар
GET {{base}}/products/1
Accept: application/json

###
# POST — створити тестовий товар 
POST {{base}}/products/add
Content-Type: application/json
Accept: application/json

{
  "title": "Практична робота WEB",
  "price": 149
}

###
# PUT — оновити назву тестового товару
PUT {{base}}/products/1
Content-Type: application/json
Accept: application/json

{
  "title": "Оновлений товар для практичної"
}

###
# DELETE — симуляція видалення товару
DELETE {{base}}/products/1
Accept: application/json

###
# GET — список товарів для девтулсів
GET {{base}}/products
Accept: application/json

### Рівень 2: додаткові REST-запити
###
GET {{base}}/users?limit=2&select=firstName,email
Accept: application/json

###
POST {{base}}/posts/add
Content-Type: application/json
Accept: application/json

{
  "title": "Дослідження HTTP методів",
  "userId": 1
}

###
# Авторизація.
POST {{base}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "username": "emilys",
  "password": "emilyspass"
}

###
# Прошла відповідь1
GET {{base}}/auth/me
Authorization: Bearer TOKEN
Accept: application/json

### Рівень 3: статуси, cookies, CORS
###
GET https://httpbin.org/status/404

###
GET https://httpbin.org/status/500

###
GET https://httpbin.org/cookies/set?user_role=student&session_key=lab1_token

###
GET https://httpbin.org/cookies
Accept: application/json

###
GET https://httpbin.org/response-headers?Set-Cookie=session_id%3Dxyz789%3B%20Path%3D%2F%3B%20Secure%3B%20HttpOnly%3B%20SameSite%3DStrict

###
OPTIONS https://httpbin.org/post
Origin: https://my-college-app.edu
Access-Control-Request-Method: POST
Access-Control-Request-Headers: Content-Type, Authorization
